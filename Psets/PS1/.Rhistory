suppressMessages({
library(haven)
library(data.table)
library(knitr)
})
dta <- as.data.table(read_dta(
"../../NFGH/ArceneauxGerberGreen_SMR_2010_ILrand_update_small_clean_nodup_EDITED.dta"
))
match_keys_full <- c("county","vote00","vote01","vote02","vote03",
"age","agemis","rymiss","newreg","female","femmis","majparty")
match_keys_lag  <- c("county","vote00","vote01",
"age","agemis","rymiss","newreg","female","femmis","majparty")
# Exact-matches assigned treatment (Z) to control within strata defined by `keys`,
# requiring >=40 controls per assigned-treated unit in the stratum (AGG's rule).
# Returns ITT, first stage, 2SLS ATT (Wald), and the contact-based "matching" ATT,
# each as a treated-share-weighted average across kept strata.
run_design <- function(dt, treat_col, contact_col, keys, outcome = "vote04", min_ctrl_per_treat = 40) {
pool <- dt[get(treat_col) == 1 | (treat == 0 & placebo == 0),
c(keys, treat_col, contact_col, outcome), with = FALSE]
setnames(pool, c(treat_col, contact_col, outcome), c("Z", "X", "Y"))
pool[, stratum := do.call(paste, c(.SD, sep = "|")), .SDcols = keys]
agg <- pool[, .(
n_t = sum(Z == 1), n_c = sum(Z == 0),
n_contact = sum(Z == 1 & X == 1),
y_t       = mean(Y[Z == 1]),
y_contact = if (sum(Z == 1 & X == 1) > 0) mean(Y[Z == 1 & X == 1]) else NA_real_,
y_c       = if (sum(Z == 0) > 0) mean(Y[Z == 0]) else NA_real_,
p_t_var       = { yt <- Y[Z == 1]; if (length(yt) > 1) var(yt) else 0 },
p_c_var       = { yc <- Y[Z == 0]; if (length(yc) > 1) var(yc) else 0 },
p_contact_var = { yx <- Y[Z == 1 & X == 1]; if (length(yx) > 1) var(yx) else 0 }
), by = stratum]
keep <- agg[n_t >= 1 & n_c >= min_ctrl_per_treat * n_t]
N_t <- sum(keep$n_t); N_c <- sum(keep$n_c); N_contact <- sum(keep$n_contact)
w_itt   <- keep$n_t / N_t
ITT     <- sum(w_itt * (keep$y_t - keep$y_c))
var_ITT <- sum(w_itt^2 * (keep$p_t_var / keep$n_t + keep$p_c_var / pmax(keep$n_c, 1)))
cr_s      <- keep$n_contact / keep$n_t
firststage <- sum(w_itt * cr_s)
var_fs     <- sum(w_itt^2 * (cr_s * (1 - cr_s)) / keep$n_t)
tsls_ATT <- ITT / firststage
se_tsls  <- sqrt(var_ITT / firststage^2 + ITT^2 * var_fs / firststage^4)
keep_c  <- keep[n_contact > 0]
w_obs   <- keep_c$n_contact / sum(keep_c$n_contact)
obs_ATT <- sum(w_obs * (keep_c$y_contact - keep_c$y_c))
var_obs <- sum(w_obs^2 * (keep_c$p_contact_var / keep_c$n_contact + keep_c$p_c_var / pmax(keep_c$n_c, 1)))
list(n_treat = N_t, n_ctrl = N_c, n_contact = N_contact, n_strata = nrow(keep),
ITT = ITT, se_ITT = sqrt(var_ITT),
firststage = firststage, se_fs = sqrt(var_fs),
tsls_ATT = tsls_ATT, se_tsls = se_tsls,
obs_ATT = obs_ATT, se_obs = sqrt(var_obs),
matched_strata = keep)
}
gotv <- run_design(dta, "treat",   "contact_treat",   match_keys_full)
keys = match_keys_full
contact_col = "contact_treat"
treat_col = "treat"
dt = dta
outcome = "vote04"
min_ctrl_per_treat = 40
pool <- dt[get(treat_col) == 1 | (treat == 0 & placebo == 0),
c(keys, treat_col, contact_col, outcome), with = FALSE]
pool
setnames(pool, c(treat_col, contact_col, outcome), c("Z", "X", "Y"))
pool
pool[, stratum := do.call(paste, c(.SD, sep = "|")), .SDcols = keys]
pool
